# Usado por APK/Capacitor y por npm run dev. Producción web usa su propio origen.
VITE_API_BASE_URL=https://private-balance.orpira.es
DATABASE_URL=
NEON_DATABASE_URL=
MAX_DEVICES_PER_LICENSE=3

# Exclusivas del servidor Vercel. No usar el prefijo VITE_.
# Proveedor de WhatsApp activo. Valores permitidos: evolution | meta-cloud.
# Ausente = evolution (compatibilidad con despliegues existentes). Un valor
# presente pero no reconocido falla explícitamente, sin fallback silencioso.
WHATSAPP_PROVIDER=evolution
N8N_AUTOMATION_WEBHOOK_URL=https://n8n.orpira.es/webhook/private-balance
N8N_DEVICE_PROVISIONING_WEBHOOK_URL=https://n8n.orpira.es/webhook/private-balance-device
N8N_WHATSAPP_WEBHOOK_URL=https://n8n.orpira.es/webhook/private-balance-whatsapp
N8N_INTERNAL_TOKEN=replace-with-a-rotated-server-token
AUTOMATION_JWT_SECRET=replace-with-at-least-32-random-characters

# Nunca definir variables VITE_ para n8n, tokens o Evolution API.
# El build falla intencionadamente si detecta una integración directa.

# Opcional: orígenes web adicionales separados por coma.
PRIVATE_BALANCE_ALLOWED_ORIGINS=https://private-balance.orpira.es

# Backend de comunicaciones (Fase 3) — WhatsApp Cloud API de Meta.
# Con WHATSAPP_CLOUD_ENABLED=false el backend arranca sin exigir ninguna
# variable META_*; los endpoints /api/communication/* responden "deshabilitado"
# y Evolution sigue funcionando exactamente igual. No poner valores reales aquí.
WHATSAPP_CLOUD_ENABLED=false
WHATSAPP_CLOUD_ALLOW_REAL_SEND=false
WHATSAPP_CLOUD_WEBHOOK_ENABLED=false
WHATSAPP_CLOUD_FORWARD_INBOUND_TO_N8N=false
WHATSAPP_CLOUD_FORWARD_STATUS_TO_N8N=false

# Obligatorias solo cuando WHATSAPP_CLOUD_ENABLED=true. META_GRAPH_API_VERSION
# no puede ser "latest" en producción (VERCEL_ENV=production): exige una
# versión explícita, p. ej. v21.0.
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_VERIFY_TOKEN=
META_WABA_ID=
META_PHONE_NUMBER_ID=
META_GRAPH_API_VERSION=

# Clave compartida para autenticar llamadas de n8n hacia
# /api/communication/whatsapp/* (Authorization: Bearer <clave>).
N8N_COMMUNICATION_API_KEY=

# Retención de datos técnicos del backend de comunicaciones, en días.
# WHATSAPP_MESSAGE_RETENTION_DAYS=0 significa "no definido explícitamente
# todavía": no se aplica una purga automática de communication_message_statuses
# en esta fase (ver docs/whatsapp/meta-cloud-backend.md).
WHATSAPP_MESSAGE_RETENTION_DAYS=0
WHATSAPP_IDEMPOTENCY_RETENTION_DAYS=30

# Fase 4: reenvío de eventos entrantes/estados hacia workflows n8n de
# staging (n8n/workflows/whatsapp-cloud/). Requieren HTTPS. Nunca poner
# URLs ni tokens reales aquí.
N8N_WHATSAPP_INBOUND_WEBHOOK_URL=
N8N_WHATSAPP_STATUS_WEBHOOK_URL=
N8N_WHATSAPP_FORWARD_AUTH_TOKEN=

# Solo entornos de staging: destinatario de prueba para envíos reales
# controlados (ver docs/whatsapp/staging-test-plan.md). Nunca un número real
# de producción, nunca en un commit con valor.
WHATSAPP_CLOUD_TEST_RECIPIENT=
